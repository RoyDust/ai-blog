# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/e2e/.auth
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build
/.generated/

# misc
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
*.pyo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# 只允许提交 .env.example 模板，其余变体（.env.local / .env.production / .env.test 等）一律忽略
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/.worktrees

# temp screenshots from agent verification runs
.tmp-*

# local agent/tooling artifacts
/.antigravitycli
/.claude/
/.codex/
/.omx/
/.opencode/
/.sisyphus/
/tasks/
/plan/

# agent/dev-server log artifacts (parallel sessions)
.audit-*.log
.codex-*.log
.dev-server*.log
.dsh-dev-server.log
.dsh-dev-server.pid
.impeccable/
