# ===== 必填 =====
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/my_next_app?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL=""

# ===== 站点配置 =====
SITE_URL="http://localhost:3000"          # 兼容旧配置；配置了 NEXT_PUBLIC_SITE_URL 时可省略

# ===== 内部接口密钥（生产环境务必配置强随机值）=====
# AI 日报与定时发布的 cron 接口 Bearer 密钥（GitHub Actions 调度用）
AI_NEWS_CRON_SECRET=""
# 定时发布接口专用密钥；缺省时依次回退到 CRON_SECRET / AI_NEWS_CRON_SECRET
PUBLISH_SCHEDULED_CRON_SECRET=""
CRON_SECRET=""
# middleware 回写操作日志的内部摄取密钥（不再回退 AUTH_SECRET；生产未配置则跳过回写）
OPERATION_LOG_INGEST_SECRET=""
# 匿名互动（点赞/评论）actor id 签名密钥
ANONYMOUS_ACTOR_SECRET=""
# Newsletter 退订链接 token 签名密钥
NEWSLETTER_TOKEN_SECRET=""

# ===== 数据库连接池 =====
DATABASE_POOL_MAX="10"

# ===== 限流 =====
# memory | database；生产默认 database，开发默认 memory
RATE_LIMIT_DRIVER=""

# ===== 图片 =====
# 生产默认禁止 next/image 加载本机/内网 IP 图片，显式设 true 才放行
NEXT_IMAGE_ALLOW_LOCAL_IP=""

# ===== Optional: 搜索引擎站点验证 =====
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# ===== Optional: GitHub sign-in =====
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ===== Optional: 七牛云上传 =====
QINIU_ACCESS_KEY=""
QINIU_SECRET_KEY=""
QINIU_BUCKET=""
QINIU_DOMAIN="https://cdn.example.com"
QINIU_UPLOAD_URL="https://up-z2.qiniup.com"

# ===== Optional: OpenAI-compatible AI 模型管理 =====
# AI_OPENAI_COMPAT_* 优先；DASHSCOPE_* 仍作为摘要模型兜底
AI_OPENAI_COMPAT_API_KEY=""
AI_OPENAI_COMPAT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
AI_OPENAI_COMPAT_MODEL="qwen3.5-flash"
AI_POST_SUMMARY_TIMEOUT_MS="120000"
AI_POST_SUMMARY_MAX_INPUT_CHARS="12000"

# ===== Optional: 遗留 DashScope 摘要兜底 =====
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_MODEL="qwen3.5-flash"

# ===== Optional: AI 封面（DashScope 图像）=====
# 优先键；缺省时回退 DASHSCOPE_API_KEY / DASHSCOPE_IMAGE_BASE_URL / DASHSCOPE_IMAGE_MODEL
AI_IMAGE_DASHSCOPE_API_KEY=""
AI_IMAGE_DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
AI_IMAGE_DASHSCOPE_MODEL="wan2.2-t2i-flash"
DASHSCOPE_IMAGE_BASE_URL=""
DASHSCOPE_IMAGE_MODEL=""
AI_IMAGE_DASHSCOPE_REQUEST_PATH="/api/v1/services/aigc/multimodal-generation/generation"

# ===== Optional: 加密存储的 AI 模型密钥主密钥 =====
# 加密数据库内模型 API key；缺省时回退 AUTH_SECRET/NEXTAUTH_SECRET
AI_MODEL_SECRET_KEY=""

# ===== Optional: Newsletter 发送 =====
# provider: console | smtp 等，按 newsletter-mailer 实现配置
NEWSLETTER_PROVIDER="console"

# ===== Optional: GitHub（AI 新闻源抓取等）=====
GITHUB_TOKEN=""

# ===== Optional: AI 新闻流水线调优（缺省即内置默认值）=====
AI_NEWS_MAX_SELECTED_CANDIDATES="20"
AI_NEWS_MAX_CANDIDATES_TO_SCORE="24"
AI_NEWS_MAX_FACT_CARDS="12"
AI_NEWS_AI_CONCURRENCY="3"
AI_NEWS_SCORE_THRESHOLD="7"
AI_NEWS_MAX_TOKENS="6000"
AI_NEWS_EDITORIAL_MAX_TOKENS="5200"
AI_NEWS_FACT_CARD_MAX_TOKENS="2200"

# ===== Optional: E2E 测试账号（Playwright + scripts/seed-e2e-admin.cjs）=====
E2E_ADMIN_EMAIL="e2e-admin@test.local"
E2E_ADMIN_PASSWORD="e2e-admin-password-2026"

# ===== 仅测试环境 =====
# 为 true 时允许测试直接调用内部操作日志摄取接口
API_OPERATION_LOG_TEST_ENABLE=""

# ===== Optional: 历史 P2 只读审计 =====
# scripts/audit-p2-history.cjs 每类最多返回的样本数，1–10000；仍报告完整命中总数
AUDIT_LIMIT="1000"

# ===== Optional: CI / 手工部署工具 =====
# GitHub 环境变量 COMPOSE_PROJECT_NAME 传入此覆盖项；须与服务器现有 Compose 项目名一致
DEPLOY_COMPOSE_PROJECT_NAME=""
# prepare-production-env.cjs 写入的稳定项目名，避免切换 release 目录后创建另一组服务
COMPOSE_PROJECT_NAME=""
